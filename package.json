{
  "name": "rewind-overlay",
  "desktopName": "rewind-overlay.desktop",
  "version": "1.0.3",
  "description": "Broadcast-quality VR, rank and race-change overlay for Retro Rewind",
  "author": {
    "name": "Rewind Overlay contributors",
    "email": "MichaelAccount1@users.noreply.github.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/MichaelAccount1/rewind-overlay",
  "repository": {
    "type": "git",
    "url": "https://github.com/MichaelAccount1/rewind-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/MichaelAccount1/rewind-overlay/issues"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"npm:dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node tools/icon.cjs",
    "screenshots": "npm run build && electron tools/capture.cjs",
    "package": "npm run build && npm run icon && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "net.rewindoverlay.app",
    "productName": "Rewind Overlay",
    "asar": true,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "obs/**/*",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "obs",
        "to": "obs"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "syncDesktopName": true,
      "synopsis": "Retro Rewind player overlay for OBS and desktop"
    }
  }
}
